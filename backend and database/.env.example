# EduSense AI Backend Environment Template
# Copy this file to .env and configure your local settings

# Project Metadata
PROJECT_NAME="EduSense AI — Automated Answer Evaluation System"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / Supabase)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For Supabase: postgresql+psycopg2://postgres.<project_id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/edusense_db"

# Secret Keys Configuration (REQUIRED IN PRODUCTION - MUST BE UNIQUE AND AT LEAST 32 CHARACTERS)
# Generate secure keys using: python3 -c "import secrets; print(secrets.token_hex(32))"

# 1. JWT Token Signing Secret Key
SECRET_KEY="generate_and_place_a_unique_32_byte_hex_secret_key_here"

# 2. Admin Teacher Provisioning Key (Used for POST /api/v1/auth/provision-teacher)
ADMIN_SECRET_KEY="generate_and_place_a_distinct_32_byte_hex_admin_key_here"

# 3. AI Evaluation Service Key (Passed via X-Service-Key header for evaluation ingestion)
EVALUATION_SERVICE_KEY="generate_and_place_a_distinct_32_byte_hex_eval_key_here"

# JWT Token Settings
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
