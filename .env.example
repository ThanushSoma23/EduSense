# ==============================================================================
# EDUSENSE AI — UNIFIED ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your keys.
# All services (Backend, Frontend, AIML-1, AIML-2, AIML-3) read from here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE BACKEND & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default local SQLite database (for PostgreSQL, use postgresql+psycopg2://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./edusense.db

# Environment mode: 'development' | 'production'
ENVIRONMENT=development

# JWT Authentication Secret Key (Used to sign user session tokens)
SECRET_KEY=dev-jwt-secret-key-edusense-2026-v1-distinct

# Admin Provisioning Key (Used for privileged teacher account operations)
ADMIN_SECRET_KEY=dev-admin-provisioning-key-edusense-2026-v2-distinct

# Evaluation Service Key (Used for inter-service communication from AIML modules)
EVALUATION_SERVICE_KEY=dev-ai-eval-service-key-edusense-2026-v3-distinct


# ------------------------------------------------------------------------------
# 2. AI SEMANTIC EVALUATION & RAG (AIML-1 & AIML-3)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Enables live LLM concept coverage & rubric feedback)
# Leave empty to use local MockGeminiCoverage fallback without any API keys.
GEMINI_API_KEY=

# Gemini model to use for concept coverage and evaluation
GEMINI_MODEL=gemini-1.5-flash

# OCR backend for AIML-1 pipeline ('easyocr' | 'trocr')
OCR_BACKEND=easyocr

# Threshold under which answers are flagged for teacher manual review
OCR_REVIEW_THRESHOLD=0.70


# ------------------------------------------------------------------------------
# 3. HANDWRITTEN OCR MODULE (AIML-2)
# ------------------------------------------------------------------------------
# Hugging Face Access Token (Optional: used to download TrOCR weights without rate limits)
HF_TOKEN=


# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (VITE)
# (Note: Vite only exposes variables prefixed with VITE_ to the browser bundle)
# ------------------------------------------------------------------------------
# API Base URL for React Frontend requests
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional Supabase client credentials (if using external Supabase storage)
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
